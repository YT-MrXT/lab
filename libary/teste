        local function updateMembers()
            if config.ApiUrl then
                task.spawn(function()
                    local success, data = pcall(function()
                        return HttpService:JSONDecode(game:HttpGet(config.ApiUrl))
                    end)
                    
                    if success and data then
                        if data.online then
                            onlineLabel.Text = tostring(data.online) .. " Online"
                        end
                        if data.total then
                            offlineLabel.Text = tostring(data.total) .. " Members"
                        end
                    end
                end)
            end
        end
        
        updateMembers()
        
        task.spawn(function()
            while discordFrame and discordFrame.Parent do
                task.wait(30)
                updateMembers()
            end
        end)
        
